<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:columnCount="2"
    android:padding="8dp"
    android:rowCount="2"
    android:theme="@style/ThemeOverlay.AppCompat.Light"
    android:orientation="vertical"
    tools:context=".WorkActivity">

    <TextView
        android:id="@+id/documentation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="50dp"
        android:background="@drawable/rounded_corner_solid"
        android:layout_gravity="center_horizontal"
        android:layout_margin="20dp"
        android:gravity="center"
        android:text="@string/documentation"
        android:textColor="@color/roundedCornerText"
        android:textSize="35sp"
        />

    <TextView
        android:id="@+id/whiteboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="50dp"
        android:background="@drawable/rounded_corner_solid"
        android:layout_gravity="center_horizontal"
        android:layout_margin="20dp"
        android:gravity="center"
        android:text="@string/whiteboard"
        android:textColor="@color/roundedCornerText"
        android:textSize="35sp"
        app:layout_constraintEnd_toEndOf="parent"
         />


</LinearLayout>